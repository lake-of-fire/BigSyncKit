+    @BigSyncBackgroundActor
+    func testUndeclaredModelsRemainIndivisibleInsteadOfSplittingHiddenInvariants() async throws {
+        let (adapter, realm) = try await fixture()
+        let initial = record(adapter, type: RebaseAtomicRow.self, id: "bounds")
+        initial["lower"] = 0 as CKRecordValue
+        initial["upper"] = 10 as CKRecordValue
+        try await deliver([initial], to: adapter)
+        let bounds = try XCTUnwrap(realm.object(ofType: RebaseAtomicRow.self, forPrimaryKey: "bounds"))
+        try realm.write {
+            bounds.lower = 8
+            bounds.refreshChangeMetadata(explicitlyModified: true, at: Date(timeIntervalSinceReferenceDate: 20))
+        }
+        let remote = record(adapter, type: RebaseAtomicRow.self, id: "bounds", at: 30)
+        remote["lower"] = 0 as CKRecordValue
+        remote["upper"] = 5 as CKRecordValue
+        try await deliver([remote], to: adapter)
+        realm.refresh()
+        XCTAssertEqual(bounds.lower, 0)
+        XCTAssertEqual(bounds.upper, 5)
+        XCTAssertLessThanOrEqual(bounds.lower, bounds.upper, "An implicit field merge would manufacture invalid 8...5 bounds")
+    }
+
+    @BigSyncBackgroundActor
+    func testEqualClockCollisionSelectsSameValueWithReplicaRolesReversed() async throws {
+        var winners = [String?]()
+        for local in ["alpha", "omega"] {
+            let (adapter, realm) = try await fixture()
+            try await deliver([row(adapter)], to: adapter)
+            let value = try edit(realm, at: 20) { $0.remoteField = local }
+            try await deliver([row(adapter, remote: local == "alpha" ? "omega" : "alpha", at: 20)], to: adapter)
+            realm.refresh()
+            winners.append(value.remoteField)
+        }
+        XCTAssertEqual(winners[0], winners[1])
+    }
+
+    @BigSyncBackgroundActor
+    func testLocalDeletionInvalidatesBaselineInTheSameRollbackBoundary() async throws {
+        let (adapter, realm) = try await fixture()
+        try await deliver([row(adapter)], to: adapter)
+        let value = try XCTUnwrap(realm.object(ofType: RebaseRow.self, forPrimaryKey: "row"))
+        let revision = try baseline(realm).revision
+        XCTAssertThrowsError(try realm.write {
+            value.isDeleted = true
+            value.refreshChangeMetadata(explicitlyModified: true, at: Date(timeIntervalSinceReferenceDate: 20))
+            XCTAssertTrue(realm.objects(BigSyncRecordBaseline.self).isEmpty)
+            throw Fault.beforeTrackingCommit
+        })
+        XCTAssertFalse(value.isDeleted)
+        XCTAssertEqual(try baseline(realm).revision, revision)
+        _ = try edit(realm) { $0.isDeleted = true }
+        XCTAssertTrue(realm.objects(BigSyncRecordBaseline.self).isEmpty)
+        _ = try edit(realm, at: 30) { $0.isDeleted = false }
+        XCTAssertTrue(realm.objects(BigSyncRecordBaseline.self).isEmpty, "Resurrection cannot reuse the deleted lifetime's ancestor")
+    }
