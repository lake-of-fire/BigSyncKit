+extension SyncRecordRebaseTests {
+    @BigSyncBackgroundActor
+    func testActualUploadDrainRebasesNormalFetchAndConflictReplyToSameResult() async throws {
+        for fetchBeforeUpload in [false, true] {
+            let (adapter, realm) = try await fixture()
+            let transport = TimelineTransport()
+            let directory = FileManager.default.temporaryDirectory
+                .appendingPathComponent("rebase-drain-" + UUID().uuidString)
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            defer { try? FileManager.default.removeItem(at: directory) }
+            let synchronizer = CloudKitSynchronizer(
+                identifier: UUID().uuidString, containerIdentifier: "iCloud.test.rebase",
+                database: TimelineDatabaseIdentity(), recordZoneID: adapter.recordZoneID,
+                keyValueStore: TimelineKeyValueStore(), accountIdentifierProvider: { "account" },
+                accountStatusProvider: { .available }, changeFeed: transport,
+                subscriptionStore: transport, zoneStore: transport, recordStore: transport,
+                backupDetectionBaseURL: directory, logger: Logger(label: "RebaseDrain")
+            )
+            synchronizer.addModelAdapter(adapter)
+            let wakeups = RebaseWakeups()
+            adapter.modelAdapterDelegate = wakeups
+            try await deliver([row(adapter)], to: adapter)
+            let value = try edit(realm) { $0.localField = "local-v1" }
+            let incoming = row(adapter, remote: "remote-v1", at: 30)
+            if fetchBeforeUpload { try await deliver([incoming], to: adapter) }
+            else {
+                await transport.enqueue(.init(conflicts: [
+                    incoming.recordID.recordName: try TimelineTransport.archive(incoming)
+                ]))
+            }
+            try await adapter.didFinishImport()
+            try await synchronizer.synchronizeAdapter(adapter)
+            try await adapter.didFinishImport()
+            XCTAssertFalse(adapter.hasChanges)
+            XCTAssertTrue(realm.objects(BigSyncPendingMutation.self).isEmpty)
+            let saved = try await transport.record(named: incoming.recordID.recordName)
+            XCTAssertEqual(saved?["remoteField"] as? String, "remote-v1")
+            XCTAssertEqual(saved?["localField"] as? String, "local-v1")
+            realm.refresh()
+            XCTAssertEqual(value.remoteField, "remote-v1")
+            XCTAssertEqual(value.localField, "local-v1")
+            let calls = await transport.history()
+            XCTAssertEqual(calls.count, fetchBeforeUpload ? 1 : 2)
+            try await synchronizer.synchronizeAdapter(adapter)
+            let quietCalls = await transport.history()
+            XCTAssertEqual(quietCalls.count, calls.count)
+            adapter.cancelSynchronization()
+            await adapter.waitForCancellation()
+        }
+    }
+
+    @BigSyncBackgroundActor
+    func testRebasedTargetBaselineAndPendingIntentSurviveDiskAdapterRecreation() async throws {
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("rebase-disk-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let revision: String
+        let pending: String
+        do {
+            let (adapter, realm) = try await fixture(directory: directory)
+            try await deliver([row(adapter)], to: adapter)
+            _ = try edit(realm) { $0.localField = "local-v1" }
+            try await deliver([row(adapter, remote: "remote-v1", at: 30)], to: adapter)
+            revision = try baseline(realm).revision
+            pending = try generation(realm)
+            adapter.cancelSynchronization()
+            await adapter.waitForCancellation()
+            adapter.invalidateTokens()
+        }
+        let (reopened, realm) = try await fixture(directory: directory)
+        XCTAssertEqual(try baseline(realm).revision, revision)
+        XCTAssertEqual(try generation(realm), pending)
+        try await deliver([row(reopened, remote: "remote-v1", at: 30)], to: reopened)
+        XCTAssertEqual(try generation(realm), pending)
+        let batch = try await reopened.prepareUploadBatch(limit: 10)
+        XCTAssertEqual(batch.records.first?["remoteField"] as? String, "remote-v1")
+        XCTAssertEqual(batch.records.first?["localField"] as? String, "local-v1")
+        reopened.cancelSynchronization()
+        await reopened.waitForCancellation()
+    }
+
+    @BigSyncBackgroundActor
+    func testMissingBaselineBlocksWithoutInventingAnAncestorOrChangingTarget() async throws {
+        let (adapter, realm) = try await fixture()
+        try await deliver([row(adapter)], to: adapter)
+        let value = try edit(realm) { $0.localField = "local-v1" }
+        let pending = try generation(realm)
+        try realm.write { realm.delete(try baseline(realm)) }
+        do {
+            try await deliver([row(adapter, remote: "remote-v1", at: 30)], to: adapter)
+            XCTFail("A missing ancestor is not proof that all local differences were authored")
+        } catch BigSyncRecordRebaseError.missingBaseline(let name) {
+            XCTAssertEqual(name, RebaseRow.className() + ".row")
+        }
+        realm.refresh()
+        XCTAssertEqual(value.remoteField, "remote-v0")
+        XCTAssertEqual(value.localField, "local-v1")
+        XCTAssertEqual(try generation(realm), pending)
+        XCTAssertTrue(realm.objects(BigSyncRecordBaseline.self).isEmpty)
+    }
+
+    @BigSyncBackgroundActor
+    func testForeignNamespaceCannotSupplyMutationAncestor() async throws {
+        let (adapter, realm) = try await fixture()
+        try await deliver([row(adapter)], to: adapter)
+        _ = try edit(realm) { $0.localField = "local-v1" }
+        let oldNamespace = try baseline(realm).namespace
+        try await adapter.activateTransportNamespace(containerIdentifier: "iCloud.test.other", databaseScope: .private)
+        do {
+            try await deliver([row(adapter, remote: "remote-v1", at: 30)], to: adapter)
