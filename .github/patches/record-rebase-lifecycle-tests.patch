+@objc(RebaseAtomicRow)
+private final class RebaseAtomicRow: Object, ChangeMetadataRecordable {
+    @Persisted(primaryKey: true) var id = "bounds"
+    @Persisted var lower = 0
+    @Persisted var upper = 10
+    @Persisted var createdAt = Date(timeIntervalSinceReferenceDate: 1)
+    @Persisted var modifiedAt = Date(timeIntervalSinceReferenceDate: 1)
+    @Persisted var explicitlyModifiedAt: Date?
+    @Persisted var isDeleted = false
+}
