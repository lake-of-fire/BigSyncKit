+    func testReevaluationColdInspectionDoesNotGrantAccountLease() {
+        let fence = AccountScopeAuthorityFence()
+        let coldGeneration = fence.publicationRestorationGeneration
+        XCTAssertTrue(fence.rejectsAuthority)
+        XCTAssertNotNil(coldGeneration)
+        fence.poison(requiresGenerationRotation: false)
+        XCTAssertNil(fence.publicationRestorationGeneration)
+        XCTAssertTrue(fence.rejectsAuthority)
+        fence.clear()
+        XCTAssertFalse(fence.rejectsAuthority)
+        XCTAssertNotNil(fence.publicationRestorationGeneration)
+        XCTAssertNotEqual(fence.publicationRestorationGeneration, coldGeneration)
+        fence.poison()
+        XCTAssertNil(fence.publicationRestorationGeneration)
+    }
